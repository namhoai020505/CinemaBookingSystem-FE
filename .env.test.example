# Full E2E test environment — DO NOT COMMIT
# Copy this file to .env.test and fill in your values

# App
PLAYWRIGHT_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5070

# SQL Server (SQL Auth)
DB_SERVER=localhost
DB_NAME=CinemaBookingDB
DB_USER=sa
DB_PASSWORD=YourPasswordHere
DB_PORT=1433

# Seed users — must exist in DB before running tests
# Admin: must have roleId = 'admin', status = 'ACTIVE', emailVerified = 1
TEST_ADMIN_EMAIL=admin@g2cinema.com
TEST_ADMIN_PASSWORD=Admin@12345

# Customer: must have roleId = 'customer', status = 'ACTIVE', emailVerified = 1
TEST_CUSTOMER_EMAIL=customer@g2cinema.com
TEST_CUSTOMER_PASSWORD=Customer@12345

# IDs of stable seed data (copy from your DB)
TEST_CINEMA_ID=cinema-001
TEST_MOVIE_ID=mv-001
TEST_SHOWTIME_ID=st-001
TEST_ROOM_ID=room-001
